      });

      let chunkCount = 0;
      const collectedChunks: any[] = [];

      for await (const chunk of uiStream) {
        collectedChunks.push(chunk);
        chunkCount++;

        if (chunkCount >= 5) {
          break;
        }
      }

      expect(chunkCount).toBe(5);
      expect(collectedChunks).toHaveLength(5);

