          role: 'assistant',
          parts: [
            {
              type: 'text',
              text: 'Hello, world.',
              state: 'done',
            },
          ],
        },
      ]);
    });
  });

  it('should show user message immediately', async () => {
    const controller = new TestResponseController();
    server.urls['/api/chat'].response = {
      type: 'controlled-stream',
