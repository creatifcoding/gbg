type ToolCallCallback<TOOLS extends ToolSet | UITools> = NonNullable<
  ChatInit<
    UIMessage<
      never,
      UIDataTypes,
      TOOLS extends ToolSet ? InferUITools<TOOLS> : TOOLS
    >
  >['onToolCall']
>;

type ToolCallArgument<TOOLS extends ToolSet | UITools> = Parameters<
  ToolCallCallback<TOOLS>
>[0]['toolCall'];

