      "type": "string",
      "description": "Canonical ISA-95 asset identifier with hierarchy prefix (ENT|SIT|ARA|PLT|LIN|WCL|MCH|SNS|DEV).",
      "title": "Asset ID",
      "pattern": "^(ENT|SIT|ARA|PLT|LIN|WCL|MCH|SNS|DEV)-[a-zA-Z0-9-]+$"
    },
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "AssetKind": {
      "type": "string",
      "enum": [
