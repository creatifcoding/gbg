{
  "name": "@tmnl/mantis-terrarium-jscad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript JSCAD authoring for the mantis terrarium enclosure envelope",
  "exports": {
    ".": "./src/index.ts"
  },
