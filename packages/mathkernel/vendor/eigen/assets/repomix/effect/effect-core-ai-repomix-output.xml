 * @memberof Number
 * @since 2.0.0
 * @category math
 * @example
 *
 * ```ts
 * import * as assert from "node:assert/strict"
 * import { remainder } from "effect/Number"
 *
 * assert.equal(remainder(2, 2), 0)
 * assert.equal(remainder(3, 2), 1)
 * assert.equal(remainder(-4, 2), -0)
 * ```
