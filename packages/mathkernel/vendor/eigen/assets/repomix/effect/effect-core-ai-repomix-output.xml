   * const numbersAndStringsHashSet: HashSet.HashSet<number | string> =
   *   HashSet.make(1, "unos", 2, "two", 3, "trois", 4, "vier")
   *
   * const stringRefinement: Predicate.Refinement<
   *   string | number,
   *   string
   * > = (value) => typeof value === "string"
   *
   * const [
