   * // The original sets are unchanged
   * assert.deepStrictEqual(HashSet.toValues(selfSet).sort(), [1, 2, 3])
   * assert.deepStrictEqual(
   *   HashSet.toValues(thatIterable).sort(),
   *   [3, 4, 5]
