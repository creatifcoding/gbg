# AI Context Artifacts (generated by ai:extract)
.ai-context/

# Docker secrets
docker/.env

# Built binaries (osmmcp, etc.)
/bin/

# Vendor sources for MCP servers
vendor/osmmcp/

# egui wasm output (built via wasm-pack)
public/egui/*
!public/egui/.gitkeep

# Agent journals and research thoughts (high-volume, ephemeral)
.agents/val/journal/
thoughts/

# Agent/editor config directories (third-party AI tools)
.adal/
.agent/
.augment/
.cline/
.codebuddy/
.codex/
.commandcode/
.continue/
.crush/
.cursor/
.factory/
.gemini/
.goose/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openclaude/
.openhands/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/

# Test artifacts and spikes (root level)
hello.txt
erl_crash.dump
_test_embed.ts
test_plant_insert.ts

# Secrets
auth.json

# Nix-scoped Elixir caches (reproducible via mix deps.get)
.nix-hex/
.nix-mix/
scripts/panel-regression/runs/*
!scripts/panel-regression/runs/.gitkeep

# pi CLI runtime state (ephemeral)
.pi/workflows/
.pi/extensions.log
.pi/mcp-tools-cache.json
.pi/mcp-tools-cache.json.bak-*
.pi/messenger/feed.jsonl

# Agent session ephemera
.agents/sessions.log

# tldr daemon runtime state
.tldr/daemon.pid
.tldr/stats/
.tldr/status

# Ad-hoc scratch template (empty by default, not real project state)
progress.md
