{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@gbg/core": ["packages/core/src/index.ts"],
      "@gbg/specs-core": ["packages/specs-core/src/index.ts"],
      "@gbg/cms": ["packages/cms/src/index.ts"],
      "@gbg/graph": ["packages/getbygraph/src/index.ts"],
      "@gbg/tmnl": ["packages/tmnl/src/index.ts"],
      "@gbg/ore": ["packages/ore/src/index.ts"],
      "@gbg/gotby": ["packages/gotby/src/index.ts"],
      "@gbg/schema-render": ["packages/schema-render/src/index.ts"],
      "@gbg/schema-render-core": ["packages/schema-render-core/src/index.ts"],
      "@gbg/schema-render-react": ["packages/schema-render-react/src/index.ts"],
      "@tmnl/effect-sui": ["packages/effect-sui/src/index.ts"],
      "@tmnl/effect-sui/*": ["packages/effect-sui/src/*"],
      "@tmnl/msh": ["packages/msh/src/index.ts"],
      "@tmnl/msh/*": ["packages/msh/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp", "submodules", "receipts"]
}
