{
  "name": "@gbg/lab-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/lab-ui/src",
  "projectType": "library",
  "tags": ["scope:gbg", "type:lib", "domain:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "packages/lab-ui"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:run",
        "cwd": "packages/lab-ui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run typecheck",
        "cwd": "packages/lab-ui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "testbed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run testbed",
        "cwd": "packages/lab-ui"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run clean",
        "cwd": "packages/lab-ui"
      }
    }
  }
}
