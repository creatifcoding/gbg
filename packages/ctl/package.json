{
  "name": "@gbg/ctl",
  "version": "0.1.0",
  "description": "Effect CLI framework with skill-driven development, agent-guiding errors, and SQLite persistence",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ctl": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./persistence": {
      "import": "./dist/persistence/index.js",
      "types": "./dist/persistence/index.d.ts"
    },
    "./messaging": {
      "import": "./dist/messaging/index.js",
      "types": "./dist/messaging/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./skills": {
      "import": "./dist/skills/index.js",
      "types": "./dist/skills/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "compile": "bun build --compile --minify src/cli/index.ts --outfile bin/ctl",
    "dev": "tsc --watch",
    "ctl": "bun run src/cli/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:bun": "bun test ./test/*.bun-test.ts",
    "test:all": "vitest run && bun test ./test/*.bun-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/cli": "^0.73.0",
    "@effect/experimental": "^0.58.0",
    "@effect/platform": "^0.94.1",
    "@effect/platform-node": "^0.104.0",
    "@effect/sql": "^0.49.0",
    "@effect/sql-sqlite-bun": "^0.50.0",
    "@opentui/core": "^0.1.74",
    "@opentui/react": "^0.1.74",
    "effect": "^3.19.14",
    "ink": "^6.6.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "react": "^19.2.3",
    "react-reconciler": "^0.32.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.18.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "effect": ">=3.0.0"
  },
  "keywords": [
    "cli",
    "effect",
    "effect-ts",
    "sqlite",
    "skills",
    "agent-guiding"
  ],
  "author": "GBG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/ctl"
  }
}
