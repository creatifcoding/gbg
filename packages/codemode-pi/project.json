{
  "name": "@tmnl/codemode-pi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/codemode-pi/src",
  "projectType": "library",
  "tags": ["scope:tmnl", "type:lib", "domain:ui", "host:pi"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "packages/codemode-pi"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:run",
        "cwd": "packages/codemode-pi"
      },
      "cache": true
    }
  }
}
