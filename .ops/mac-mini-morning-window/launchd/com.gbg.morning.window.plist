<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>            <string>com.gbg.morning.window</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/lib/gbg-morning/window-manager.sh</string>
    </array>
    <!-- Fires at each window. pmset (RTC) wakes the machine; launchd then runs this. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>  <string>/var/log/gbg-morning.log</string>
    <key>StandardErrorPath</key><string>/var/log/gbg-morning.log</string>
</dict>
</plist>
