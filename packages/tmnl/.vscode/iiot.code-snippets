  "Effect Stream Pattern": {
    "prefix": "effect-stream",
    "scope": "typescript",
    "description": "Effect Stream with provideLayer pattern",
    "body": [
      "import { Stream, Effect } from 'effect'",
      "",
      "const ${1:streamName} = Stream.fromEffect(",
      "  Effect.gen(function* () {",
      "    $0",
      "  })",
      ").pipe(",
      "  Stream.provideLayer(${2:ServiceLive})",
      ")"
    ]
  }
}
