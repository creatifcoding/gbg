{
  "name": "@tmnl/lnk",
  "version": "0.0.1",
  "author": "GBG",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/lnk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts/index.js",
      "types": "./dist/contracts/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./services/lnks": {
      "import": "./dist/services/lnks/index.js",
      "types": "./dist/services/lnks/index.d.ts"
    },
    "./services/wire": {
      "import": "./dist/services/wire/index.js",
      "types": "./dist/services/wire/index.d.ts"
    },
    "./services/wire/in-memory": {
      "import": "./dist/services/wire/in-memory/index.js",
      "types": "./dist/services/wire/in-memory/index.d.ts"
    },
    "./services/wire/http": {
      "import": "./dist/services/wire/http/index.js",
      "types": "./dist/services/wire/http/index.d.ts"
    },
    "./services/wire/nats-bridge": {
      "import": "./dist/services/wire/nats-bridge/index.js",
      "types": "./dist/services/wire/nats-bridge/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "NATS-BRIDGE.md"
  ],
  "description": "Effect v4-native Durable Streams client + server-adapter library. Spec-faithful implementation of the Durable Streams wire protocol with first-class Yieldable handles, Pull-driven offset tracking, and stx atom integration.",
  "keywords": [
    "effect-ts",
    "effect-v4",
    "durable-streams",
    "streaming",
    "kafka",
    "append-only-log",
    "stx",
    "yieldable"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=junit --outputFile=reports/junit.xml",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist reports",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@tmnl/msh": "workspace:*",
    "effect": "4.0.0-beta.93"
  },
  "peerDependencies": {
    "@tmnl/stx": "workspace:*",
    "react": ">=18.0.0",
    "@effect/atom-react": "4.0.0-beta.93"
  },
  "peerDependenciesMeta": {
    "@tmnl/stx": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@effect/atom-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@durable-streams/client": "0.2.3",
    "@durable-streams/server-conformance-tests": "0.3.0",
    "@tmnl/stx": "workspace:*",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@effect/vitest": "4.0.0-beta.93",
    "@effect/atom-react": "4.0.0-beta.93"
  }
}
