   * assert.deepStrictEqual(
   *   satisfying,
   *   HashSet.make("unos", "two", "trois", "vier")
   * )
   * ```
   */
  <A, B extends A>(
    self: HashSet<A>,
    refinement: Refinement<A, B>
  ): [excluded: HashSet<Exclude<A, B>>, satisfying: HashSet<B>]

  /**
   * @example
   *
   * ```ts
   * import { HashSet } from "effect"
   * import * as assert from "node:assert/strict"
   *
