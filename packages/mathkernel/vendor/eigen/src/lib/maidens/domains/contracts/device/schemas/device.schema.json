      "required": [
        "latitude",
        "longitude",
        "building",
        "floor",
        "zone",
        "address",
        "timezone"
      ],
      "properties": {
        "latitude": {
          "anyOf": [
            {
              "type": "number",
              "description": "a number between -90 and 90",
              "title": "between(-90, 90)",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "longitude": {
          "anyOf": [
            {
              "type": "number",
              "description": "a number between -180 and 180",
              "title": "between(-180, 180)",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "building": {
