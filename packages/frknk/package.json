{
  "name": "@gbg/frknk",
  "version": "0.0.1",
  "author": "GBG",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/frknk"
  },
  "description": "FRKNK \u2014 Quisk/Hermes SDR foundation, RF sketch contracts, and TMNL integration surface",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    },
    "./cockpit": {
      "import": "./dist/cockpit.js",
      "types": "./dist/cockpit.d.ts"
    },
    "./iq-corpus": {
      "import": "./dist/iq-corpus.js",
      "types": "./dist/iq-corpus.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "sdr",
    "quisk",
    "hermes-lite",
    "rfml",
    "effect-schema",
    "tmnl"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist reports"
  },
  "dependencies": {
    "effect": "4.0.0-beta.93"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
