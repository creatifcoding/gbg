{
  "name": "@tmnl/specimendb",
  "version": "0.0.1",
  "description": "Specimen store: DuckDB + Effect v4 RPC. ECS entity is SpecimenId.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rpc": {
      "import": "./dist/rpc/index.js",
      "types": "./dist/rpc/index.d.ts"
    },
    "./duckdb": {
      "import": "./dist/duckdb/index.js",
      "types": "./dist/duckdb/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "assets",
    "capture"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=junit --outputFile=reports/junit.xml",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist reports",
    "capture:vendor": "bun ./scripts/vendor-capture.mjs",
    "capture:zip": "bun run capture:vendor && cd capture && zip -r ../specimendb-capture.zip . -x '*.DS_Store'",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "effect": "4.0.0-beta.93",
    "exifr": "^7.1.3"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "^1.4.2"
  },
  "devDependencies": {
    "@6over3/zeroperl-ts": "1.0.10",
    "@effect/vitest": "4.0.0-beta.93",
    "@types/node": "20.19.9",
    "@uswriting/exiftool": "1.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "GBG",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/specimendb"
  },
  "keywords": [
    "effect-ts",
    "effect-v4",
    "duckdb",
    "specimen",
    "specimendb"
  ]
}
