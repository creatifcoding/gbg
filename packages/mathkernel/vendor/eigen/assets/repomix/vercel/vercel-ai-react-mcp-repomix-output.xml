            formatChunk({ type: 'start' }),
            formatChunk({ type: 'start-step' }),
            formatChunk({
              type: 'tool-input-available',
              toolCallId: 'tool-call-0',
              toolName: 'test-tool',
              input: { testArg: 'test-value' },
