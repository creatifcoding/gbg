use flake

# ORDER Postgres E2E profile (local tmnl_postgres container)
export ORDER_POSTGRES_E2E=1
export ORDER_POSTGRES_HOST=localhost
export ORDER_POSTGRES_PORT=5432
export ORDER_POSTGRES_USER=tmnl
export ORDER_POSTGRES_PASSWORD=tmnl_dev_password
export ORDER_POSTGRES_DATABASE=tmnl
export ORDER_POSTGRES_SSL=false
export ORDER_POSTGRES_POOL_SIZE=5
export ORDER_POSTGRES_TIMEOUT_MS=15000
export ORDER_POSTGRES_TABLE_PREFIX=maiden_order_runtime
