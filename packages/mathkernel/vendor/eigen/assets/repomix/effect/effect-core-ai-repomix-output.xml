    const Make extends NoExcessProperties<{
      readonly effect:
        | Effect<Service.AllowedType<Key, Make>, any, any>
        | ((...args: any) => Effect<Service.AllowedType<Key, Make>, any, any>)
      readonly dependencies?: ReadonlyArray<Layer.Layer.Any>
