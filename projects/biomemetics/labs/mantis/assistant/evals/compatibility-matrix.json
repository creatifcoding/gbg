{
  "schemaVersion": "1.0.0",
  "kind": "EvalProgram",
  "description": "A0 compatibility matrix. CI uses the fake model. The opt-in live lane consumes a Codex or ChatGPT subscription session.",
  "network": false,
  "credentials": false,
  "lanes": {
    "ci": {
      "model": "mantis-fake-model@1.0.0",
      "network": false,
      "credentials": false
    },
    "live": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max",
      "provider": "@mastra/code-sdk@1.4.0 openai-codex",
      "credential": "Mastra Code auth.json openai-codex OAuth",
      "optIn": "MASTRA_LIVE=1",
      "network": true,
      "credentials": true,
      "node": ">=22.19.0",
      "apiKey": false,
      "emptyWell": "CODEX_SUBSCRIPTION_AUTH_REQUIRED",
      "cursorPlanTokens": false
    }
  },
  "cases": [
    "agui-streaming-reconnect",
    "controller-modes-isolated-sessions",
    "resource-thread-binding",
    "mode-tool-deny-precedence",
    "stale-approval-after-restart",
    "constrained-subagent-boundary",
    "thread-om-privacy-filter",
    "dynamic-workflow-registration-version",
    "workflow-suspend-resume",
    "durable-reconnect-readonly",
    "trace-redaction-run-correlation",
    "deterministic-eval-invocation",
    "in-process-agui-bind"
  ]
}
