{
  "name": "@tmnl/pi-workflows",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/pi-workflows/src",
  "projectType": "library",
  "tags": ["scope:tmnl", "type:lib", "host:pi", "effect:v4", "domain:workflow"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "packages/pi-workflows"
      },
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run typecheck",
        "cwd": "packages/pi-workflows"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:run",
        "cwd": "packages/pi-workflows"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "smoke:extension": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run smoke:extension",
        "cwd": "packages/pi-workflows"
      },
      "cache": false
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run clean",
        "cwd": "packages/pi-workflows"
      }
    }
  }
}
