diff --git a/packages/tmnl/psi/sync-forks-and-submodules.sh b/packages/tmnl/psi/sync-forks-and-submodules.sh
new file mode 100755
index 0000000..a5056c1
--- /dev/null
+++ b/packages/tmnl/psi/sync-forks-and-submodules.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Usage:
+#   bash psi/sync-forks-and-submodules.sh [owner]
+# Default owner: psi
+
+OWNER="${1:-psi}"
+ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+MAP_FILE="$ROOT_DIR/psi/repos.json"
+SUBMODULE_ROOT="$ROOT_DIR/psi/submodules"
+
+mkdir -p "$SUBMODULE_ROOT"
+
+if ! command -v gh >/dev/null 2>&1; then
+  echo "gh CLI is required" >&2
+  exit 1
+fi
+
+if ! command -v jq >/dev/null 2>&1; then
+  echo "jq is required" >&2
+  exit 1
+fi
+
+echo "[psi] Target owner: $OWNER"
+echo "[psi] Map: $MAP_FILE"
+
+jq -c '.[]' "$MAP_FILE" | while read -r row; do
+  upstream="$(echo "$row" | jq -r '.upstream')"
+  target_template="$(echo "$row" | jq -r '.target')"
+  target_repo="${OWNER}/${target_template#*/}"
+  target_name="${target_repo#*/}"
+
+  echo "\n[psi] Forking $upstream -> $target_repo"
+
+  if gh repo view "$target_repo" >/dev/null 2>&1; then
+    echo "[psi] Repo already exists: $target_repo"
+  else
+    gh repo fork "$upstream" --org "$OWNER" --fork-name "$target_name" --remote=false --clone=false
+    echo "[psi] Fork created: $target_repo"
+  fi
+
+  submodule_path="psi/submodules/$target_name"
+
+  if git -C "$ROOT_DIR" config --file .gitmodules --get-regexp "submodule\.${submodule_path//\//\.}\.path" >/dev/null 2>&1; then
+    echo "[psi] Submodule already configured: $submodule_path"
+  else
+    echo "[psi] Adding submodule $target_repo at $submodule_path"
+    git -C "$ROOT_DIR" submodule add "git@github.com:${target_repo}.git" "$submodule_path"
+  fi
+
+  # Ensure upstream remote exists inside submodule clone
+  if [ -d "$ROOT_DIR/$submodule_path/.git" ] || [ -f "$ROOT_DIR/$submodule_path/.git" ]; then
+    if git -C "$ROOT_DIR/$submodule_path" remote get-url upstream >/dev/null 2>&1; then
+      :
+    else
+      git -C "$ROOT_DIR/$submodule_path" remote add upstream "git@github.com:${upstream}.git"
+      echo "[psi] Added upstream remote in $submodule_path"
+    fi
+  fi
+
+done
+
+echo "\n[psi] Done. Review with:"
+echo "  git status --short"
+echo "  git submodule status"
