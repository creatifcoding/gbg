{
  "name": "@gbg/nexus",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cosmo/WunderGraph federated GraphQL router home. tmnl consumes.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
