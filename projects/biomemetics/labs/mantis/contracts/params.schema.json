{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specimendb:biomemetics:mantis:contracts:parameters:v1",
  "title": "Mantis workspace parameter set",
  "description": "Cross-language representation of values and their epistemic status. A value is not a measurement unless evidenceRefs contains measured evidence.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "parameterSetId",
    "workspaceRef",
    "revision",
    "parameters"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "ParameterSet"
    },
    "parameterSetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "workspaceRef": {
      "const": "biomemetics.mantis"
    },
    "contextRef": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "ref",
        "relation"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "source",
            "evidence",
            "decision",
            "derived-from"
          ]
        }
      },
      "additionalProperties": false
    },
    "tolerance": {
      "type": "object",
      "properties": {
        "plus": {
          "type": "number",
          "minimum": 0
        },
        "minus": {
          "type": "number",
          "minimum": 0
        },
        "symmetric": {
          "type": "number",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "plus",
            "minus"
          ],
          "not": {
            "required": [
              "symmetric"
            ]
          }
        },
        {
          "required": [
            "symmetric"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "plus"
                ]
              },
              {
                "required": [
                  "minus"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "locked",
            "measured",
            "calculated",
            "simulated",
            "target",
            "ref",
            "typ",
            "unverified"
          ]
        },
        "tolerance": {
          "$ref": "#/$defs/tolerance"
        },
        "range": {
          "type": "object",
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unverified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          },
          "else": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "measured"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidenceRefs",
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "locked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "references"
            ]
          }
        },
        {
          "if": {
            "required": ["value"],
            "properties": {
              "value": { "type": "number" }
            }
          },
          "then": {
            "required": ["unit"]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
