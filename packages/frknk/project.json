{
  "name": "@gbg/frknk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/frknk/src",
  "projectType": "library",
  "tags": ["scope:gbg", "type:lib", "domain:sdr", "effect:v4"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "packages/frknk"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:run",
        "cwd": "packages/frknk"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run typecheck",
        "cwd": "packages/frknk"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "py:lock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv lock",
        "cwd": "packages/frknk/experiments/sdr-lab"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "py:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --extra dev pytest",
        "cwd": "packages/frknk/experiments/sdr-lab"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "py:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --extra dev ruff check .",
        "cwd": "packages/frknk/experiments/sdr-lab"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run clean",
        "cwd": "packages/frknk"
      }
    }
  }
}
