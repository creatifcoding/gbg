            "type": "text-delta",
          },
          "delay 10",
          {
            "id": "1",
            "text": "check ",
            "type": "text-delta",
          },
          "delay 10",
          {
            "id": "1",
            "text": "the ",
            "type": "text-delta",
          },
          "delay 10",
          {
            "id": "1",
            "text": "weather ",
            "type": "text-delta",
          },
          "delay 10",
          {
