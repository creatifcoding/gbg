# git-crypt fronts this directory: every real secret file is transparently
# encrypted in the repo and only readable with the local git-crypt key.
# sops (age) encrypts the values inside FIRST, so a committed secret is
# git-crypt( sops( plaintext ) ). Config / docs / examples stay readable.
* filter=git-crypt diff=git-crypt
.gitattributes !filter !diff
.sops.yaml     !filter !diff
README.md      !filter !diff
*.example      !filter !diff
*.example.*    !filter !diff
