      "type": "string",
      "description": "Device identifier in DEV-{slug} format.",
      "title": "Device ID",
      "pattern": "^DEV-[a-zA-Z0-9-]+$"
    },
    "NonEmptyString": {
      "type": "string",
      "description": "a non empty string",
      "title": "nonEmptyString",
      "minLength": 1
    },
    "DeviceStatus": {
      "type": "string",
      "enum": [
        "provisioned",
        "online",
        "offline",
        "faulted",
        "firmware_update",
        "decommissioned"
      ],
      "description": "ISA-95 control-module lifecycle status for device assets.",
      "title": "Device Status"
    },
    "DeviceType": {
      "type": "string",
      "enum": [
        "motor",
        "valve",
        "pump",
        "heater",
        "cooler",
        "conveyor",
        "actuator",
        "servo",
        "relay",
        "vfd",
        "solenoid",
        "gripper",
        "light",
        "alarm",
        "other"
      ],
      "description": "Industrial actuator category for ISA-95 level-0 devices.",
      "title": "Device Type"
    },
    "DeviceControlMode": {
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "remote",
        "local"
      ],
      "description": "Operational authority mode for device command handling.",
      "title": "Device Control Mode"
    },
    "DevicePowerUnit": {
      "type": "string",
      "enum": [
        "watts",
        "kilowatts",
        "horsepower"
      ],
      "description": "Rated power unit for actuator assets.",
      "title": "Device Power Unit"
    },
    "DeviceLocation": {
