 * @memberof MutableHashSet
 * @since 2.0.0
 * @category elements
 * @example
 *
 * ```ts
 * import { MutableHashSet } from "effect"
 * import assert from "node:assert/strict"
 *
 * assert.equal(MutableHashSet.size(MutableHashSet.empty()), 0)
