{
  "name": "@gbg/theia-ide",
  "version": "0.0.1",
  "private": true,
  "description": "TMNL Theia IDE integration - embeddable code editor with Vim mode and LSP support",
  "license": "MIT",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module"
    }
  ],
  "theia": {
    "target": "browser-only",
    "frontend": {
      "config": {
        "applicationName": "TMNL Editor",
        "preferences": {
          "files.enableTrash": false,
          "editor.minimap.enabled": false,
          "editor.renderWhitespace": "none",
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "workbench.colorTheme": "Default Dark+"
        }
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode-vim": "https://open-vsx.org/api/vscodevim/vim/1.27.2/file/vscodevim.vim-1.27.2.vsix"
  },
  "dependencies": {
    "@theia/core": "1.55.0",
    "@theia/editor": "1.55.0",
    "@theia/filesystem": "1.55.0",
    "@theia/workspace": "1.55.0",
    "@theia/navigator": "1.55.0",
    "@theia/search-in-workspace": "1.55.0",
    "@theia/file-search": "1.55.0",
    "@theia/keymaps": "1.55.0",
    "@theia/markers": "1.55.0",
    "@theia/outline-view": "1.55.0",
    "@theia/monaco": "1.55.0",
    "@theia/messages": "1.55.0",
    "@theia/output": "1.55.0",
    "@theia/preferences": "1.55.0",
    "@theia/userstorage": "1.55.0",
    "@theia/variable-resolver": "1.55.0",
    "browserfs": "^1.4.3"
  },
  "devDependencies": {
    "@babel/runtime": "^7.24.0",
    "@phosphor/algorithm": "^1.2.0",
    "@phosphor/commands": "^1.7.0",
    "@phosphor/coreutils": "^1.3.0",
    "@phosphor/domutils": "^1.1.0",
    "@phosphor/dragdrop": "^1.4.0",
    "@phosphor/messaging": "^1.3.0",
    "@phosphor/properties": "^1.1.0",
    "@phosphor/signaling": "^1.3.0",
    "@phosphor/virtualdom": "^1.2.0",
    "@phosphor/widgets": "^1.9.0",
    "@theia/application-manager": "1.55.0",
    "@theia/cli": "1.55.0",
    "@theia/monaco-editor-core": "1.83.101",
    "@vscode/codicons": "^0.0.35",
    "async-mutex": "^0.4.0",
    "buffer": "^6.0.3",
    "compression-webpack-plugin": "^11.0.0",
    "cookie": "^0.6.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^6.10.0",
    "dompurify": "^3.0.0",
    "es6-promise": "^4.2.8",
    "express": "^4.18.0",
    "fast-deep-equal": "^3.1.3",
    "fast-json-stable-stringify": "^2.1.0",
    "fast-plist": "^0.1.3",
    "file-icons-js": "^1.1.0",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.2.0",
    "fuzzy": "^0.1.3",
    "http-proxy-agent": "^7.0.0",
    "http-server": "^14.1.1",
    "http-status-codes": "^2.3.0",
    "https-proxy-agent": "^7.0.0",
    "iconv-lite": "^0.6.3",
    "idb": "^8.0.0",
    "ignore-loader": "^0.1.2",
    "inversify": "^6.0.0",
    "jschardet": "^3.0.0",
    "jsonc-parser": "^3.2.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "markdown-it": "^14.0.0",
    "mini-css-extract-plugin": "^2.8.0",
    "minimatch": "^9.0.0",
    "msgpackr": "^1.10.0",
    "p-debounce": "^4.0.0",
    "p-queue": "^8.0.0",
    "path-browserify": "^1.0.1",
    "perfect-scrollbar": "^1.5.5",
    "react-autosize-textarea": "^7.1.0",
    "react-perfect-scrollbar": "^1.5.8",
    "react-tooltip": "^5.26.0",
    "react-virtuoso": "^4.7.0",
    "reflect-metadata": "^0.2.1",
    "resolve-package-path": "^4.0.0",
    "route-parser": "^0.0.5",
    "safer-buffer": "^2.1.2",
    "setimmediate": "^1.0.5",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "source-map-loader": "^5.0.0",
    "string-replace-loader": "^3.1.0",
    "style-loader": "^3.3.0",
    "ts-md5": "^1.3.1",
    "typescript": "~5.4.0",
    "umd-compat-loader": "^2.1.0",
    "uuid": "^9.0.0",
    "valid-filename": "^4.0.0",
    "vscode-languageserver-protocol": "^3.17.0",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-oniguruma": "^2.0.0",
    "vscode-textmate": "^9.0.0",
    "vscode-uri": "^3.0.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "ws": "^8.16.0",
    "yargs": "^17.7.0"
  },
  "scripts": {
    "postinstall": "./scripts/fix-bun-symlinks.sh",
    "prepare:no-native": "theia rebuild:browser",
    "download:plugins": "theia download:plugins",
    "clean": "theia clean && rimraf lib",
    "generate": "theia generate && ./scripts/patch-vanta-extension.sh",
    "build": "bun run generate && bunx webpack --config webpack.config.js --mode=development",
    "build:prod": "bun run generate && bunx webpack --config webpack.config.js --mode=production",
    "start": "theia start --hostname=127.0.0.1 --port=3035",
    "start:debug": "theia start --hostname=127.0.0.1 --port=3035 --loglevel=debug",
    "watch": "theia build --watch --mode=development"
  },
  "theiaPluginsExcludeIds": []
}
