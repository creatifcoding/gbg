{
  "version": 1,
  "workspace": "projects/biomemetics/labs/mantis",
  "mutationPolicy": "The orchestrator owns this graph. Issue agents read it and modify only their declared write set.",
  "modelPolicy": {
    "planner": { "model": "grok-4.6", "effort": "xhigh", "fast": false },
    "implementer": { "model": "grok-4.5", "fast": false },
