  expect(isHotkeyPressed('meta')).toBe(true)
})

test('should support multiple hotkeys', async () => {
  const user = userEvent.setup()

  await user.keyboard('{B>}{A>}')

  expect(isHotkeyPressed('a')).toBe(true)
  expect(isHotkeyPressed('b')).toBe(true)
