{
  "name": "@gbg/catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Biomimetic research catalog. 10-second intake into filed cards",
  "author": "GBG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/catalog"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf .output dist .data"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.0",
    "effect": "4.0.0-beta.93",
    "exifr": "^7.1.3",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "gbg",
    "catalog",
    "biomimetic",
    "tanstack-start"
  ]
}
