{
  "name": "@gbg/cluster",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Lab Alchemy host for kube context k3d-tmnl and Pepr lab CRDs on tmnl.gbg.dev/v1alpha1.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./crd": {
      "types": "./src/crd/index.ts",
      "import": "./src/crd/index.ts",
      "default": "./src/crd/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.110",
    "pepr": "0.52.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.8.3",
    "vitest": "^4.1.11"
  }
}
