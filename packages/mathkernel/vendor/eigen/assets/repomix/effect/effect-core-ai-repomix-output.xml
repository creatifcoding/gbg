/** @internal */
export const succeed = dual<
  <I, S>(
    tag: Context.Tag<I, S>
  ) => (
    resource: Types.NoInfer<S>
  ) => Layer.Layer<I>,
  <I, S>(
    tag: Context.Tag<I, S>,
