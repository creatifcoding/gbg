{
  "Effect Schema TaggedStruct": {
    "prefix": "effect-schema",
    "scope": "typescript",
    "description": "Effect Schema.TaggedStruct pattern for domain types",
    "body": [
      "/**",
      " * ${1:Entity} Schema",
      " */",
      "export const ${1:Entity} = Schema.TaggedStruct('${1:Entity}', {",
      "  id: ${1:Entity}Id,",
      "  name: Schema.NonEmptyString,",
      "  status: ${1:Entity}Status,",
      "  $0",
      "})",
      "export type ${1:Entity} = Schema.Schema.Type<typeof ${1:Entity}>"
    ]
  },
  "Effect Schema TaggedClass": {
    "prefix": "effect-schema-class",
    "scope": "typescript",
    "description": "Effect Schema.TaggedClass pattern with methods",
    "body": [
      "export class ${1:Entity} extends Schema.TaggedClass<${1:Entity}>()('${1:Entity}', {",
      "  id: ${1:Entity}Id,",
      "  ...BaseAssetFields,",
      "  status: ${1:Entity}Status,",
      "  $0",
      "}) {",
      "  getAutomationLevel(): number {",
      "    return ${2:1}",
      "  }",
      "",
      "  isOperational(): boolean {",
      "    return this.status === 'active'",
      "  }",
      "}"
    ]
  },
  "Effect Service + Context.Tag + Layer": {
    "prefix": "effect-service",
    "scope": "typescript",
    "description": "Effect.Service definition with Context.Tag and Layer",
    "body": [
      "import { Effect, Context, Layer } from 'effect'",
      "",
      "export interface ${1:ServiceName}Shape {",
      "  readonly ${2:method}: (${3:param}: ${4:ParamType}) => Effect.Effect<${5:ReturnType}>",
      "}",
      "",
      "export class ${1:ServiceName} extends Context.Tag('${6:namespace}/${1:ServiceName}')<",
      "  ${1:ServiceName},",
      "  ${1:ServiceName}Shape",
      ">() {}",
      "",
      "export const ${1:ServiceName}Live: Layer.Layer<${1:ServiceName}> = Layer.succeed(",
      "  ${1:ServiceName},",
      "  {",
      "    ${2:method}: (${3:param}) => $0",
      "  }",
      ")"
    ]
  },
  "Effect Entity (Cluster)": {
    "prefix": "effect-entity",
    "scope": "typescript",
    "description": "Effect Cluster Entity.make template",
    "body": [
      "import { Entity } from '@effect/cluster'",
      "import { Rpc } from '@effect/rpc'",
      "import { Schema, Effect } from 'effect'",
      "",
      "export const ${1:Entity}Type = '${1:Entity}' as const",
      "export const ${1:Entity}CreateTag = `\\${${1:Entity}Type}.Create` as const",
      "export const ${1:Entity}GetTag = `\\${${1:Entity}Type}.Get` as const",
      "",
      "export class Create${1:Entity}Rpc extends Rpc.make(${1:Entity}CreateTag, {",
      "  payload: Create${1:Entity}Params,",
      "  primaryKey: ({ slug }) => slug,",
      "  success: ${1:Entity},",
      "  error: RpcQueryError,",
      "}) {}",
      "",
      "export class Get${1:Entity}Rpc extends Rpc.make(${1:Entity}GetTag, {",
      "  payload: Schema.Struct({ ${2:entityId}: Schema.String }),",
      "  primaryKey: ({ ${2:entityId} }) => ${2:entityId},",
      "  success: ${1:Entity},",
      "  error: RpcNotFoundError,",
      "}) {}",
      "",
      "export const ${1:Entity}Entity = Entity.make(${1:Entity}Type, [",
      "  Create${1:Entity}Rpc,",
      "  Get${1:Entity}Rpc,",
      "  $0",
      "])"
    ]
  },
  "Effect State Service": {
    "prefix": "effect-state",
    "scope": "typescript",
    "description": "State service + InMemory layer pattern",
    "body": [
      "import { Effect, Context, Layer, Ref } from 'effect'",
      "",
      "export interface ${1:Entity}StateShape {",
      "  readonly get: (id: string) => Effect.Effect<${1:Entity}, ${1:Entity}NotFoundError>",
      "  readonly set: (entity: ${1:Entity}) => Effect.Effect<void>",
      "  readonly list: (filter: ${1:Entity}Filter) => Effect.Effect<readonly ${1:Entity}[]>",
      "  readonly delete: (id: string) => Effect.Effect<boolean>",
      "}",
      "",
      "export class ${1:Entity}State extends Context.Tag('iiot/${1:Entity}State')<",
      "  ${1:Entity}State,",
      "  ${1:Entity}StateShape",
      ">() {}",
      "",
      "export const ${1:Entity}StateInMemory: Layer.Layer<${1:Entity}State> = Layer.effect(",
      "  ${1:Entity}State,",
      "  Ref.make(new Map<string, ${1:Entity}>()).pipe(",
      "    Effect.map((store) => ({",
      "      get: (id) => Ref.get(store).pipe(",
      "        Effect.flatMap((m) => m.has(id) ? Effect.succeed(m.get(id)!) : Effect.fail(new ${1:Entity}NotFoundError(id)))",
      "      ),",
      "      set: (entity) => Ref.update(store, (m) => { const n = new Map(m); n.set(entity.id, entity); return n }),",
      "      list: (_filter) => Ref.get(store).pipe(Effect.map((m) => Array.from(m.values()))),",
      "      delete: (id) => Ref.modify(store, (m) => { const had = m.has(id); if (had) { const n = new Map(m); n.delete(id); return [true, n] as const } return [false, m] as const }),",
      "      $0",
      "    }))",
      "  )",
      ")"
    ]
  },
  "Effect RPC Group": {
    "prefix": "effect-rpc",
    "scope": "typescript",
    "description": "RPC Group via EntityProxy.toRpcGroup()",
    "body": [
      "import { RpcGroup } from '@effect/rpc'",
      "import { EntityProxy } from '@effect/cluster'",
      "import { ${1:Entity}Entity } from '../entity/${1:Entity}Entity'",
      "",
      "export class ${1:Entity}EntityRpcs extends EntityProxy.toRpcGroup(${1:Entity}Entity) {}",
      "",
      "export const ${1:Entity}Rpcs = RpcGroup.make(",
      "  ...Array.from(${1:Entity}EntityRpcs.requests.values())",
      ")",
      "",
      "export type ${1:Entity}Rpcs = typeof ${1:Entity}Rpcs"
    ]
  },
  "Effect Vitest Test": {
    "prefix": "effect-test",
    "scope": "typescript",
    "description": "Effect vitest it.effect() test template",
    "body": [
      "import { describe, expect } from 'vitest'",
      "import { it } from '@effect/vitest'",
      "import { Effect } from 'effect'",
      "",
      "describe('${1:subject}', () => {",
      "  it.effect('${2:should do something}', () =>",
      "    Effect.gen(function* () {",
      "      const result = yield* ${3:Effect.succeed('test')}",
      "      expect(result).toBe(${4:'test'})",
      "    }).pipe(",
      "      Effect.provide(${5:TestLayer})",
      "    )",
      "  )",
      "})"
    ]
  },
  "IIoT Asset Schema (ISA-95)": {
    "prefix": "iiot-schema",
    "scope": "typescript",
    "description": "ISA-95 compliant asset schema with hierarchy fields",
    "body": [
      "import { Schema } from 'effect'",
      "import { BaseAssetFields } from '../common'",
      "",
      "export const ${1:Entity}Id = Schema.String.pipe(",
      "  Schema.pattern(/^${2:ENT}-[a-zA-Z0-9-]+$/),",
      "  Schema.brand('${1:Entity}Id'),",
      ")",
      "export type ${1:Entity}Id = typeof ${1:Entity}Id.Type",
      "",
      "export const make${1:Entity}Id = (slug: string): ${1:Entity}Id => `${2:ENT}-\\${slug}` as ${1:Entity}Id",
      "",
      "export const ${1:Entity}Status = Schema.Literal(",
      "  'planned', 'active', 'inactive', 'maintenance', 'decommissioned'",
      ")",
      "export type ${1:Entity}Status = typeof ${1:Entity}Status.Type",
      "",
      "export class ${1:Entity} extends Schema.TaggedClass<${1:Entity}>()('${1:Entity}', {",
      "  id: ${1:Entity}Id,",
      "  ...BaseAssetFields,",
      "  status: ${1:Entity}Status,",
      "  $0",
      "}) {",
      "  getAutomationLevel(): number { return ${3:1} }",
      "  isOperational(): boolean { return this.status === 'active' }",
      "  materializePath(): string { return this.hierarchyPath.toString() }",
      "}"
    ]
  },
