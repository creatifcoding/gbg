{
  "name": "@tmnl/stx",
  "version": "0.0.1",
  "author": "GBG",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/stx"
  },
  "main": "./dist/index.js",
  "peerDependencies": {
    "@effect/atom-react": ">=4.0.0-beta.0",
    "react": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks.js",
      "types": "./dist/hooks.d.ts"
    }
  },
  "description": "Unified state factory \u2014 effect-atom (reactive data) \u00d7 XState (logic) \u00d7 Effect (services)",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "state",
    "effect-ts",
    "xstate",
    "effect-atom",
    "reactive",
    "state-machine"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@effect/atom-react": {
      "optional": true
    },
    "@xstate/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=junit --outputFile=reports/junit.xml",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist reports",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "xstate": "^5.20.0",
    "effect": "4.0.0-beta.93"
  },
  "devDependencies": {
    "@tanstack/db": "^0.5.32",
    "@tanstack/store": "^0.9.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@xstate/react": "^6.1.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@effect/vitest": "4.0.0-beta.93",
    "@effect/atom-react": "4.0.0-beta.93"
  }
}
