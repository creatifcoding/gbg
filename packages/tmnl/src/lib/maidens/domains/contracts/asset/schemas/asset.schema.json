          "anyOf": [
            {
              "type": "number",
              "description": "a number between -90 and 90",
              "title": "between(-90, 90)",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "longitude": {
          "anyOf": [
            {
              "type": "number",
