    expect(mergeObjects(undefined, undefined)).toBeUndefined();

    // One input undefined
    expect(mergeObjects({ a: 1 }, undefined)).toEqual({ a: 1 });
    expect(mergeObjects(undefined, { b: 2 })).toEqual({ b: 2 });
  });
});
