        "site",
        "area",
        "plant",
        "line",
        "workcell",
        "machine",
        "sensor",
        "device"
      ],
      "description": "ISA-95 equipment hierarchy discriminator.",
      "title": "Asset Kind"
    },
    "AssetStatus": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "maintenance",
        "decommissioned"
      ],
      "description": "Polymorphic ISA-95 asset lifecycle status.",
      "title": "Asset Status"
