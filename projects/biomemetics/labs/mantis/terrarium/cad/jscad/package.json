    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jscad/modeling": "^2.13.0",
    "@jscad/svg-serializer": "^2.3.21"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  }
}
