{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "effect-v4": ["../../node_modules/effect-v4"],
      "effect-v4/*": ["../../node_modules/effect-v4/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "reports", "coverage", "node_modules", "test", "**/*.test.ts"]
}
