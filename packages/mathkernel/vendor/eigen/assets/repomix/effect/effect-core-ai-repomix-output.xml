/** @internal */
export const diff = <Key, Value, Patch>(
  options: {
    readonly oldValue: HashMap.HashMap<Key, Value>
    readonly newValue: HashMap.HashMap<Key, Value>
    readonly differ: Differ.Differ<Value, Patch>
  }
