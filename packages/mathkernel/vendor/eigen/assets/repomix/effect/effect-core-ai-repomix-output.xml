  /**
   * @since 2.0.0
   * @category models
   */
  export interface Variance<in out K, in out V> {
    readonly [TMapTypeId]: {
      readonly _K: Types.Invariant<K>
      readonly _V: Types.Invariant<V>
    }
  }
}

