{
  "schemaVersion": "1.0.0",
  "kind": "EvalProgram",
  "description": "A0 compatibility matrix. CI uses the fake model. The opt-in live lane is OpenRouter openai/gpt-5.6-luna gated by OPENROUTER_API_KEY.",
  "network": false,
  "credentials": false,
  "lanes": {
    "ci": {
      "model": "mantis-fake-model@1.0.0",
      "network": false,
      "credentials": false
    },
    "live": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "max",
      "provider": "openrouter openai-compatible",
      "credential": "OPENROUTER_API_KEY",
      "baseUrl": "https://openrouter.ai/api/v1",
      "optIn": "MASTRA_LIVE=1",
      "network": true,
      "credentials": true,
      "openaiApiKey": false,
      "codexLogin": false,
      "cursorPlanTokens": false,
      "emptyWell": "OPENROUTER_CREDENTIAL_REQUIRED",
      "inProcessBind": "MastraAgent.getLocalAgents into CopilotRuntime, no runtimeUrl"
    }
  },
  "cases": [
    "agui-streaming-reconnect",
    "controller-modes-isolated-sessions",
    "resource-thread-binding",
    "mode-tool-deny-precedence",
    "stale-approval-after-restart",
    "constrained-subagent-boundary",
    "thread-om-privacy-filter",
    "dynamic-workflow-registration-version",
    "workflow-suspend-resume",
    "durable-reconnect-readonly",
    "trace-redaction-run-correlation",
    "deterministic-eval-invocation",
    "in-process-agui-bind"
  ]
}
