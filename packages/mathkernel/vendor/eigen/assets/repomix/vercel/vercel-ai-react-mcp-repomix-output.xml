              case 1:
                expect(options).toStrictEqual({
                  prompt,
                  n: 1,
                  seed: 12345,
                  size: '1024x1024',
                  aspectRatio: '16:9',
                  providerOptions: { 'mock-provider': { style: 'vivid' } },
                  headers: {
                    'custom-request-header': 'request-header-value',
                    'user-agent': 'ai/0.0.0-test',
                  },
                  abortSignal: undefined,
                });
                return createMockResponse({
