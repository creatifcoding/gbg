      }
    )
  );

  store.send({ type: 'inc' }); // count = 1
  store.send({ type: 'log' }); // count = 1 (logged but not undoable)
  store.send({ type: 'inc' }); // count = 2
  expect(store.getSnapshot().context.count).toBe(2);

