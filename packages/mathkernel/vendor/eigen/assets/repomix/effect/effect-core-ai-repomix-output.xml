    self: Effect.Effect<A, E, R>,
    tag: Context.Tag<I, S>,
    effect: Effect.Effect<Types.NoInfer<S>, E1, R1>
  ) => Effect.Effect<A, E | E1, R1 | Exclude<R, I>>
>(3, <A, E, R, I, S, E1, R1>(
  self: Effect.Effect<A, E, R>,
  tag: Context.Tag<I, S>,
  effect: Effect.Effect<Types.NoInfer<S>, E1, R1>
