{
  "name": "mantis-biomemetics-lab",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "root": "projects/biomemetics/labs/mantis",
  "tags": [
    "scope:biomemetics",
    "type:lab-workspace",
    "domain:mantis",
    "evidence:specimendb"
  ],
  "targets": {
    "validate-contracts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 scripts/validate-contracts.py",
        "cwd": "projects/biomemetics/labs/mantis"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "test-python": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/test-python.sh",
        "cwd": "projects/biomemetics/labs/mantis"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "test-typescript": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tooling/typescript/mantis-lab/test/*.test.ts",
        "cwd": "projects/biomemetics/labs/mantis"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "test-rust": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --manifest-path tooling/rust/mantis-lab-verifier/Cargo.toml",
        "cwd": "projects/biomemetics/labs/mantis"
      },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/tooling/rust/mantis-lab-verifier/target"]
    },
    "verify-core": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/verify-core.sh",
        "cwd": "projects/biomemetics/labs/mantis"
      },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/evidence/generated"]
    },
    "verify-fabrication": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/verify-fabrication.sh",
        "cwd": "projects/biomemetics/labs/mantis"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bash scripts/verify-core.sh",
          "bash scripts/verify-fabrication.sh"
        ],
        "cwd": "projects/biomemetics/labs/mantis",
        "parallel": false
      },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/evidence/generated"]
    }
  }
}
