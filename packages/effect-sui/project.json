{
  "name": "@tmnl/effect-sui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/effect-sui/src",
  "projectType": "library",
  "tags": ["scope:tmnl", "type:lib", "domain:data", "domain:blockchain", "effect:v4"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "packages/effect-sui"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run typecheck",
        "cwd": "packages/effect-sui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:run",
        "cwd": "packages/effect-sui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:unit",
        "cwd": "packages/effect-sui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test:property": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:property",
        "cwd": "packages/effect-sui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:integration",
        "cwd": "packages/effect-sui"
      },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:e2e",
        "cwd": "packages/effect-sui"
      },
      "cache": false,
      "inputs": ["default", "^default"]
    },
    "test:e2e:skip": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run test:e2e:skip",
        "cwd": "packages/effect-sui"
      },
      "cache": false,
      "inputs": ["default", "^default"]
    },
    "audit:boundaries": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run audit:boundaries",
        "cwd": "packages/effect-sui"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "quality": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run quality",
        "cwd": "packages/effect-sui"
      },
      "cache": false,
      "inputs": ["default", "^default"]
    },
    "quality:localnet": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run quality:localnet",
        "cwd": "packages/effect-sui"
      },
      "cache": false,
      "inputs": ["default", "^default"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run clean",
        "cwd": "packages/effect-sui"
      }
    }
  }
}
