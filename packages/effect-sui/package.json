{
  "name": "@tmnl/effect-sui",
  "version": "0.0.1",
  "description": "Effect-smol-first executable Sui SDK layer \u2014 Schema domains, Effectable PTBs/queries/flows, STM reservations, and Mysten SDK adapters",
  "type": "module",
  "sideEffects": false,
  "author": "GBG",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbg/gbg.git",
    "directory": "packages/effect-sui"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./effectable": {
      "import": "./dist/effectable/index.js",
      "types": "./dist/effectable/index.d.ts"
    },
    "./services": {
      "import": "./dist/services/index.js",
      "types": "./dist/services/index.d.ts"
    },
    "./ptb": {
      "import": "./dist/ptb/index.js",
      "types": "./dist/ptb/index.d.ts"
    },
    "./query": {
      "import": "./dist/query/index.js",
      "types": "./dist/query/index.d.ts"
    },
    "./flow": {
      "import": "./dist/flow/index.js",
      "types": "./dist/flow/index.d.ts"
    },
    "./diagnostics": {
      "import": "./dist/diagnostics/index.js",
      "types": "./dist/diagnostics/index.d.ts"
    },
    "./reservation": {
      "import": "./dist/reservation/index.js",
      "types": "./dist/reservation/index.d.ts"
    },
    "./package": {
      "import": "./dist/package/index.js",
      "types": "./dist/package/index.d.ts"
    },
    "./adapter": {
      "import": "./dist/adapter/index.js",
      "types": "./dist/adapter/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run src test/unit",
    "test:property": "vitest run test/property --passWithNoTests",
    "test:integration": "vitest run test/integration --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "test:e2e:skip": "EFFECT_SUI_E2E_MODE=skip bun run test:e2e",
    "audit:boundaries": "bash scripts/audit-boundaries.sh",
    "quality": "bun run audit:boundaries && bun run typecheck && bun run test:run && bun run test:property && bun run test:e2e:skip && bun run build",
    "quality:localnet": "bun run quality && bun run test:e2e",
    "clean": "rm -rf dist reports coverage",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {
    "@mysten/bcs": "^2.0.5",
    "@mysten/sui": "^2.16.3",
    "effect": "4.0.0-beta.93"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.11.0",
    "@types/node": "^25.0.8",
    "fast-check": "^4.6.0",
    "testcontainers": "^11.11.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@effect/vitest": "4.0.0-beta.93"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "effect-ts",
    "effect-smol",
    "effect-v4",
    "sui",
    "mysten",
    "blockchain",
    "stm",
    "ptb"
  ]
}
